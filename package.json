{
  "name": "guitab",
  "version": "1.0.0",
  "author": "Guillaume FAUVET",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/fauvet/guitab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fauvet/guitab.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:devcontainer": "ng serve --host 0.0.0.0",
    "start:agent": "ng serve --configuration agent",
    "emulators:agent": "firebase emulators:start --only auth,database --project demo-guitab",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "setup:env": "node scripts/setup-env.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d docs",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:rules:emulator": "firebase emulators:exec --only database --project demo-guitab \"npm run test:rules\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-docs.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:coverage": "ng test --no-watch --coverage",
    "verify": "npm run lint && npm run format:check && npm run check:docs && npm run typecheck && npm run test:coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "^22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/material": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@angular/service-worker": "^22.0.2",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "chordproject-editor": "^0.1.11",
    "chordproject-parser": "^0.2.14",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "firebase": "^12.16.0",
    "javascript-time-ago": "^2.5.11",
    "lodash": "^4.17.21",
    "material-icons": "^1.13.12",
    "rxjs": "~7.8.0",
    "safe-pipe": "^3.0.4",
    "svguitar": "^2.4.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.2",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.15",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.1",
    "firebase-tools": "^15.27.0",
    "gh-pages": "^6.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,scss,css,json,webmanifest,md}": [
      "prettier --write"
    ]
  }
}
