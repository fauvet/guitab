/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // `types` replaces the list rather than extending it, so the File System
    // Access declarations that tsconfig.app.json pulls in have to be repeated
    // here — otherwise the app compiles and the tests do not, over the same
    // source.
    "types": ["vitest/globals", "@types/wicg-file-system-access"]
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
